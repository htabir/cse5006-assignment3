# Copy to .env and fill in. Production values live in Render's Environment tab, never in git.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# GitHub OAuth App (https://github.com/settings/developers). Callback must match the app exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# Random string >= 32 chars (openssl rand -base64 48)
JWT_SECRET=

# postgres://USER:PASSWORD@HOST:PORT/DATABASE  (Neon: append ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_capsule
